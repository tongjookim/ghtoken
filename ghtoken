#!/usr/bin/env bash
# ghtoken — GitHub 토큰 중앙 관리 도구
# 저장 위치: /etc/ghtoken/profiles/<프로필>.conf  (root 전용, 디렉터리 700 / 파일 600)
# 토큰 값은 화면·명령행 인자(ps)에 노출하지 않는다. 'env'/'header'/'credential'만 원문을 표준출력으로 낸다.
set -euo pipefail
umask 077
BASE=/etc/ghtoken/profiles
PROFILE=default

die(){ echo "ghtoken: $*" >&2; exit 1; }
need_root(){ [ "$(id -u)" -eq 0 ] || die "root 권한이 필요합니다"; }
conf(){ echo "$BASE/$PROFILE.conf"; }
mask(){ local t=$1; [ ${#t} -le 8 ] && { echo "****"; return; }; echo "${t:0:4}****${t: -4}"; }

usage(){ cat <<'U'
사용법: ghtoken [-p 프로필] <명령>
  set                 사용자/토큰 입력 (토큰은 화면에 안 보임; 파이프 입력도 가능)
  import <.env파일>   GITHUB_USER / GITHUB_TOKEN 를 읽어와 저장
  push [저장소] [git push 인자...]
                      현재 git 디렉터리를 푸시. 저장소를 생략하면 물어봄
                      (owner/repo 또는 https://github.com/owner/repo.git, 기본 브랜치=현재 HEAD)
  show                저장된 정보 표시 (토큰은 마스킹)
  list                프로필 목록
  verify              GitHub API로 토큰 유효성·권한 확인
  env                 export 문 출력 →  eval "$(ghtoken env)"
  header              Authorization: Basic 헤더 출력 (git -c http.extraHeader 용)
  credential get      git credential helper 모드
  rm                  프로필 삭제
기본 프로필: default
git 연동: git config --global credential.https://github.com.helper '!/usr/local/sbin/ghtoken credential'
U
}

load(){
  local f; f=$(conf); [ -r "$f" ] || die "프로필 '$PROFILE' 없음 ($f)"
  GITHUB_USER= GITHUB_TOKEN=
  local k v
  while IFS='=' read -r k v; do
    case "$k" in GITHUB_USER|GITHUB_TOKEN) v=${v%\"}; v=${v#\"}; printf -v "$k" '%s' "$v";; esac
  done < "$f"
  [ -n "$GITHUB_TOKEN" ] || die "프로필 '$PROFILE'에 토큰이 없습니다"
}

save(){
  need_root
  [[ "$PROFILE" =~ ^[A-Za-z0-9._-]+$ ]] || die "프로필 이름이 잘못됨"
  [[ "$GITHUB_TOKEN" =~ ^[A-Za-z0-9_]+$ ]] || die "토큰 형식이 이상합니다"
  local f tmp; f=$(conf); tmp=$(mktemp "$BASE/.tmp.XXXXXX")
  { echo "# ghtoken profile: $PROFILE  (updated $(date '+%F %T'))"
    echo "GITHUB_USER=$GITHUB_USER"
    echo "GITHUB_TOKEN=$GITHUB_TOKEN"; } > "$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
  echo "저장됨: $f (토큰 $(mask "$GITHUB_TOKEN"))"
}

while getopts "p:h" o; do case $o in p) PROFILE=$OPTARG;; *) usage; exit 0;; esac; done
shift $((OPTIND-1))
cmd=${1:-help}; shift || true

case "$cmd" in
  set)
    need_root
    [ -r "$(conf)" ] && { load || true; }
    if [ -t 0 ]; then
      read -rp "GitHub 사용자명 [${GITHUB_USER:-}]: " u; GITHUB_USER=${u:-${GITHUB_USER:-}}
      read -rsp "토큰 (입력 안 보임): " GITHUB_TOKEN; echo
    else
      read -r GITHUB_TOKEN; GITHUB_USER=${GITHUB_USER:-${1:-}}
    fi
    [ -n "$GITHUB_USER" ] || die "사용자명이 필요합니다"
    save ;;
  import)
    f=${1:-}; [ -r "$f" ] || die "파일을 읽을 수 없음: $f"
    GITHUB_USER= GITHUB_TOKEN=
    while IFS='=' read -r k v; do
      k=${k#export }; case "$k" in GITHUB_USER|GITHUB_TOKEN) v=${v%\"}; v=${v#\"}; v=${v%\'}; v=${v#\'}; printf -v "$k" '%s' "$v";; esac
    done < "$f"
    [ -n "$GITHUB_TOKEN" ] || die "$f 에 GITHUB_TOKEN 이 없습니다"
    save ;;
  show)
    load
    echo "프로필 : $PROFILE ($(conf))"
    echo "사용자 : $GITHUB_USER"
    echo "토큰   : $(mask "$GITHUB_TOKEN")"
    echo "수정일 : $(stat -c '%y' "$(conf)" | cut -d. -f1)" ;;
  list)
    shopt -s nullglob; for f in "$BASE"/*.conf; do n=$(basename "$f" .conf); echo "$n"; done ;;
  verify)
    load
    out=$(printf 'header = "Authorization: Bearer %s"\n' "$GITHUB_TOKEN" | \
      curl -sS -D - -o /tmp/.ghtoken.$$ -K - -H 'Accept: application/vnd.github+json' https://api.github.com/user) || die "API 호출 실패"
    code=$(echo "$out" | head -1 | awk '{print $2}')
    login=$(grep -o '"login": *"[^"]*"' /tmp/.ghtoken.$$ | head -1 | cut -d'"' -f4 || true); rm -f /tmp/.ghtoken.$$
    scopes=$(echo "$out" | grep -i '^x-oauth-scopes:' | cut -d: -f2- | tr -d '\r' || true)
    exp=$(echo "$out" | grep -i '^github-authentication-token-expiration:' | cut -d: -f2- | tr -d '\r' || true)
    echo "HTTP $code  로그인: ${login:--}  scopes:${scopes:- (fine-grained 또는 없음)}  만료:${exp:- 없음/알 수 없음}"
    [ "$code" = 200 ] || exit 1 ;;
  env)
    load
    printf 'export GITHUB_USER=%q\nexport GITHUB_TOKEN=%q\nexport GH_TOKEN=%q\n' "$GITHUB_USER" "$GITHUB_TOKEN" "$GITHUB_TOKEN" ;;
  push)
    load
    git rev-parse --git-dir >/dev/null 2>&1 || die "git 저장소 디렉터리에서 실행하세요"
    repo=${1:-}; [ $# -gt 0 ] && shift
    if [ -z "$repo" ]; then
      [ -t 0 ] || die "저장소를 인자로 주세요: ghtoken push owner/repo"
      read -rp "푸시할 저장소 (owner/repo 또는 URL): " repo
    fi
    repo=${repo%/}
    case "$repo" in
      https://github.com/*) url=$repo ;;
      git@github.com:*)     url="https://github.com/${repo#git@github.com:}" ;;
      */*)                  url="https://github.com/$repo" ;;
      "")                   die "저장소가 비었습니다" ;;
      *)                    url="https://github.com/$GITHUB_USER/$repo" ;;
    esac
    [[ "$url" == *.git ]] || url="$url.git"
    [[ "$url" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\.git$ ]] || die "저장소 형식이 잘못됨: $url"
    [ $# -gt 0 ] || set -- HEAD
    echo "→ $url  ($*)  [프로필: $PROFILE]"
    # 토큰은 인자로 넘기지 않고 credential helper로만 전달 (ps에 노출 안 됨)
    exec git -c credential.helper= \
      -c "credential.https://github.com.helper=!/usr/local/sbin/ghtoken -p $PROFILE credential" \
      push "$url" "$@" ;;
  header)
    load; printf 'Authorization: Basic %s\n' "$(printf '%s' "$GITHUB_USER:$GITHUB_TOKEN" | base64 -w0)" ;;
  credential)
    [ "${1:-}" = get ] || exit 0          # store/erase 는 무시
    host=
    while IFS= read -r line && [ -n "$line" ]; do case "$line" in host=*) host=${line#host=};; esac; done
    [ "$host" = github.com ] || exit 0
    load; printf 'username=%s\npassword=%s\n' "$GITHUB_USER" "$GITHUB_TOKEN" ;;
  rm)
    need_root; f=$(conf); [ -e "$f" ] || die "프로필 없음"; rm -f "$f"; echo "삭제됨: $f" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
